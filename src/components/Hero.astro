---
import ImagePlaceholder from './ImagePlaceholder.astro';
---

<section class="gradient-hero pt-28 pb-16 md:pt-36 md:pb-24">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-2 lg:gap-16">
    <div>
      <span
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-brand-700"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
        SaaS para consultorios medicos
      </span>

      <h1 class="text-4xl font-bold leading-tight tracking-tight text-slate-900 md:text-5xl lg:text-[3.25rem]">
        Su consultorio organizado
        <span class="text-brand-600"> desde el celular</span>
      </h1>

      <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate-600">
        Agenda, pacientes, historial y recetas en un solo lugar. Pensado para medicos que trabajan
        solos o sin asistente, con el movil como herramienta principal.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/25 transition hover:bg-brand-700"
        >
          Solicitar piloto gratuito
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
          </svg>
        </a>
        <a
          href="#como-funciona"
          class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-7 py-3.5 text-sm font-semibold text-slate-700 transition hover:border-brand-200 hover:text-brand-600"
        >
          Ver como funciona
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-slate-500">
        <li class="flex items-center gap-2">
          <svg class="h-5 w-5 text-teal-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path></svg>
          Sin instalacion compleja
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-5 w-5 text-teal-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path></svg>
          Acceso seguro con login
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-5 w-5 text-teal-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path></svg>
          Listo en minutos
        </li>
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
      <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-brand-100/80 to-teal-100/50 blur-2xl"></div>
      <div class="relative">
        <ImagePlaceholder
          label="Captura: agenda del dia"
          hint="Reemplace con screenshot del dashboard en movil"
          aspect="phone"
          class="mx-auto shadow-2xl shadow-brand-900/10"
        />
      </div>
    </div>
  </div>
</section>
