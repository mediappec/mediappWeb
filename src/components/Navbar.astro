---
const links = [
  { href: '#funciones', label: 'Funciones' },
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#beneficios', label: 'Beneficios' },
  { href: '#faq', label: 'Preguntas' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/60 bg-white/80 backdrop-blur-lg">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="#" class="flex items-center gap-2.5">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-sm font-bold text-white shadow-sm"
        >M</span
      >
      <span class="text-lg font-bold tracking-tight text-slate-900">MediApp</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="text-sm font-medium text-slate-600 transition hover:text-brand-600"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="#contacto"
        class="hidden rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 sm:inline-block"
      >
        Plan Fundador
      </a>
      <a
        href="#contacto"
        class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white sm:hidden"
      >
        Fundador
      </a>
    </div>
  </nav>
</header>
