---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  label: string;
  hint?: string;
  aspect?: 'phone' | 'wide' | 'square' | 'card';
  class?: string;
  /** Filename relative to src/images, e.g. "hero-mediapp.webp" */
  src?: string;
  alt?: string;
}

const { label, hint, aspect = 'wide', class: className = '', src, alt } = Astro.props;

const aspectClass = {
  phone: 'aspect-[9/19] max-w-[280px]',
  wide: 'aspect-video w-full',
  square: 'aspect-square w-full',
  card: 'aspect-[4/3] w-full',
}[aspect];

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/**/*.{jpeg,jpg,png,gif,webp,avif}',
);

let image: ImageMetadata | undefined;

if (src) {
  const key = `/src/images/${src.replace(/^\//, '')}`;
  const loader = images[key];

  if (!loader) {
    throw new Error(
      `Image "${key}" not found. Available: ${Object.keys(images).join(', ') || '(none)'}`,
    );
  }

  image = (await loader()).default;
}
---

{
  image ? (
    <div class={`overflow-hidden rounded-2xl ${aspectClass} ${className}`}>
      <Image
        src={image}
        alt={alt ?? label}
        class="h-full w-full object-cover"
        widths={[280, 420, 640, 960, 1280]}
        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
      />
    </div>
  ) : (
    <div class={`image-placeholder ${aspectClass} ${className}`}>
      <div class="relative z-10 flex flex-col items-center gap-3 px-6 py-8 text-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-10 w-10 text-brand-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"
          ></path>
        </svg>
        <p class="text-sm font-semibold text-brand-700">{label}</p>
        {hint && <p class="max-w-xs text-xs text-brand-500/80">{hint}</p>}
      </div>
    </div>
  )
}
