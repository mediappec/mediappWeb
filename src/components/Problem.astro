---
const problems = [
  {
    icon: 'calendar',
    title: 'Citas dispersas',
    text: 'Las citas se pierden o se anotan en mil lugares: papel, WhatsApp, memoria.',
  },
  {
    icon: 'phone',
    title: 'El celular es su herramienta',
    text: 'A veces no hay computadora en el consultorio; el telefono siempre esta a mano.',
  },
  {
    icon: 'clock',
    title: 'Poco tiempo entre pacientes',
    text: 'Necesita ver el contexto rapido: quien es, que paso la vez pasada.',
  },
];
---

<section class="border-y border-slate-100 bg-slate-50 py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">El problema</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
        Menos caos administrativo, mas tiempo para escuchar
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Muchos consultorios independientes no tienen asistente fijo. MediApp ordena lo esencial
        para que usted se enfoque en sus pacientes.
      </p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      {
        problems.map(({ icon, title, text }) => (
          <article class="rounded-2xl border border-slate-200/80 bg-white p-8 shadow-sm transition hover:shadow-md">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              {icon === 'calendar' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"></path>
                </svg>
              )}
              {icon === 'phone' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"></path>
                </svg>
              )}
              {icon === 'clock' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-slate-600 leading-relaxed">{text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
