---
const planFeatures = [
  'App completa: citas, pacientes, historias y recetas PDF',
  'Subdominio propio para su consultorio',
  'Setup y capacitacion de 30–45 min',
  'Uso desde el celular, sin instalacion compleja',
  'Soporte prioritario durante los 3 meses',
  'A cambio: uso real, 2 sesiones de feedback y testimonio',
];
---

<section id="contacto" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="gradient-cta overflow-hidden rounded-3xl shadow-2xl shadow-brand-900/20">
      <div class="grid gap-10 p-8 md:p-12 lg:grid-cols-2 lg:items-center lg:p-16">
        <div class="text-white">
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-100">Lanzamiento</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">
            Plan Fundador
          </h2>
          <p class="mt-4 text-lg text-brand-100 leading-relaxed">
            Tres meses sin mensualidad. Solo paga <span class="font-semibold text-white">$49 USD</span> de
            instalacion y usa MediApp en su consultorio real mientras nos ayuda a mejorarla.
          </p>
          <ul class="mt-8 space-y-3">
            {
              planFeatures.map((item) => (
                <li class="flex items-center gap-3 text-brand-50">
                  <svg class="h-5 w-5 shrink-0 text-teal-300" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-brand-100/90">
            Cupos limitados (15–20 fundadores). Al dia 90 pasa al Plan Consultorio desde $19/mes
            (recomendado: semestral).
          </p>
        </div>

        <div class="rounded-2xl bg-white p-8 shadow-xl">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-bold text-slate-900">$49</span>
            <span class="text-sm text-slate-500">USD · instalacion unica</span>
          </div>
          <p class="mt-1 text-sm font-medium text-teal-700">3 meses sin suscripcion</p>
          <h3 class="mt-5 text-xl font-bold text-slate-900">Solicite su cupo</h3>
          <p class="mt-2 text-sm text-slate-600">
            Complete sus datos y nos pondremos en contacto para activar su Plan Fundador.
          </p>

          <form id="contact-form" class="mt-6 space-y-4" action="/api/contact" method="post" novalidate>
            <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <div>
              <label for="nombre" class="mb-1.5 block text-sm font-medium text-slate-700">Nombre completo</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                maxlength="200"
                placeholder="Dr. Juan Perez"
                class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-slate-700">Correo electronico</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                maxlength="254"
                placeholder="doctor@consultorio.com"
                class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
              />
            </div>
            <div>
              <label for="telefono" class="mb-1.5 block text-sm font-medium text-slate-700">Telefono / WhatsApp</label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                required
                maxlength="50"
                placeholder="+593 99 123 4567"
                class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
              />
            </div>
            <button
              type="submit"
              id="contact-submit"
              class="w-full rounded-xl bg-brand-600 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Solicitar Plan Fundador
            </button>
            <p id="contact-feedback" class="hidden text-center text-sm" role="status" aria-live="polite"></p>
            <p class="text-center text-xs text-slate-400">
              Cupos limitados. Respuesta en menos de 24 horas.
            </p>
          </form>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-6 text-center sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-3xl font-bold text-brand-600">$49</p>
        <p class="mt-1 text-sm text-slate-600">Instalacion unica</p>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-3xl font-bold text-brand-600">3 meses</p>
        <p class="mt-1 text-sm text-slate-600">Sin mensualidad</p>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-3xl font-bold text-brand-600">15–20</p>
        <p class="mt-1 text-sm text-slate-600">Cupos de fundadores</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('contact-submit');
  const feedback = document.getElementById('contact-feedback');
  const defaultLabel = submitBtn?.textContent ?? 'Solicitar Plan Fundador';

  function showFeedback(message, type) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.classList.remove('hidden', 'text-emerald-600', 'text-red-600');
    feedback.classList.add(type === 'success' ? 'text-emerald-600' : 'text-red-600');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitBtn) return;

    const data = new FormData(form);
    const payload = {
      nombre: String(data.get('nombre') || '').trim(),
      email: String(data.get('email') || '').trim(),
      telefono: String(data.get('telefono') || '').trim(),
      website: String(data.get('website') || '').trim(),
    };

    if (!payload.nombre || !payload.email || !payload.telefono) {
      showFeedback('Complete todos los campos.', 'error');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';
    feedback?.classList.add('hidden');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await res.json().catch(() => ({ ok: false }));

      if (!res.ok || !result.ok) {
        showFeedback(result.error || 'No se pudo enviar. Intente mas tarde.', 'error');
        return;
      }

      form.reset();
      showFeedback('Recibimos su solicitud. Nos contactaremos pronto.', 'success');
    } catch {
      showFeedback('Error de conexion. Intente mas tarde.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = defaultLabel;
    }
  });
</script>
