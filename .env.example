LANDING_PORT=127.0.0.1:13080
LANDING_IMAGE=tu_usuario_dockerhub/mediapp-landing:latest
CONTACT_API_IMAGE=tu_usuario_dockerhub/mediapp-landing-contact-api:latest
COMPOSE_PROJECT_NAME=mediapp-landing

# Google Tag Manager (ej. GTM-XXXXXXX). Vacío = no se inyecta.
# Se usa en el build de Docker (ARG), no en runtime de nginx.
PUBLIC_GTM_ID=

# SMTP PrivateEmail — runtime del servicio contact-api (no es build arg)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@mediappec.com
SMTP_PASS=
CONTACT_TO=contact@mediappec.com
CONTACT_FROM=contact@mediappec.com
